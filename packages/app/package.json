{
  "name": "@magpiejs/app",
  "version": "0.0.0",
  "description": "Magpie entry point",
  "type": "module",
  "license": "MIT",
  "bin": {
    "magpie": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch --clear-screen=false --include ../../plugins/*/src --include ../../packages/*/src src/cli.ts --dev"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@cordisjs/plugin-server": "1.7.0",
    "@cordisjs/plugin-timer": "1.1.3",
    "@magpiejs/database": "0.0.0",
    "@magpiejs/jobs": "0.0.0",
    "@magpiejs/system": "0.0.0",
    "@magpiejs/webui": "0.0.0",
    "cordis": "4.0.0-rc.10"
  }
}
