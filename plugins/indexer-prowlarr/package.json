{
  "name": "@magpiejs/indexer-prowlarr",
  "version": "0.0.0",
  "description": "Prowlarr integration for Magpie: pulls indexers over Prowlarr's v1 API and accepts pushes over the Radarr/Sonarr v3 API",
  "type": "module",
  "license": "MIT",
  "magpie": {
    "namespace": "prowlarr",
    "provider": {
      "kind": "indexer",
      "label": "Prowlarr",
      "single": true,
      "basic": [
        "url",
        "apiKey"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@magpiejs/auth": "0.0.0",
    "@magpiejs/database": "0.0.0",
    "@magpiejs/indexer-torznab": "0.0.0",
    "@magpiejs/indexers": "0.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@cordisjs/plugin-http": "^1.5.2",
    "@cordisjs/plugin-server": "^1.7.0",
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@cordisjs/plugin-http": "1.5.2",
    "@cordisjs/plugin-timer": "^1.1.3",
    "@magpiejs/decision": "0.0.0",
    "@magpiejs/jobs": "0.0.0",
    "cordis": "4.0.0-rc.10",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
