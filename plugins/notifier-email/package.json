{
  "name": "@magpiejs/notifier-email",
  "version": "0.0.0",
  "description": "Email notifications for Magpie",
  "type": "module",
  "license": "MIT",
  "magpie": {
    "provider": {
      "kind": "notifier",
      "label": "Email",
      "basic": [
        "name",
        "host",
        "port",
        "security",
        "username",
        "password",
        "from",
        "to",
        "onImported",
        "onUpgraded",
        "onFailed",
        "onGrabbed"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@magpiejs/notifications": "0.0.0",
    "@magpiejs/types": "0.0.0",
    "schemastery": "^3.18.0",
    "nodemailer": "^10.0.13"
  },
  "peerDependencies": {
    "@cordisjs/plugin-http": "^1.5.2",
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@magpiejs/testing": "0.0.0",
    "cordis": "4.0.0-rc.10",
    "@types/nodemailer": "^8.0.2"
  }
}
