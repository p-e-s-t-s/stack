{
  "name": "@magpiejs/downloader-deluge",
  "version": "0.0.0",
  "description": "Deluge download client for Magpie",
  "type": "module",
  "license": "MIT",
  "magpie": {
    "provider": {
      "kind": "download-client",
      "label": "Deluge",
      "basic": [
        "name",
        "url",
        "password"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@magpiejs/downloads": "0.0.0",
    "@magpiejs/types": "0.0.0",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@cordisjs/plugin-http": "^1.5.2",
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@cordisjs/plugin-http": "1.5.2",
    "cordis": "4.0.0-rc.10"
  }
}
