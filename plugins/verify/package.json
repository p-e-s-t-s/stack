    "@magpiejs/downloads": "0.0.0",
    "@magpiejs/import": "0.0.0",
    "@magpiejs/library": "0.0.0",
    "@magpiejs/media-tools": "0.0.0",
    "@magpiejs/parser": "0.0.0",
    "@magpiejs/probe": "0.0.0",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@magpiejs/history": "0.0.0",
    "@magpiejs/movies": "0.0.0",
    "@magpiejs/testing": "0.0.0",
    "cordis": "4.0.0-rc.10",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
