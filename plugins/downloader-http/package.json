{
  "name": "@magpiejs/downloader-http",
  "version": "0.0.0",
  "description": "Direct downloads over HTTP for Magpie (podcast episodes and other plain URLs)",
  "type": "module",
  "license": "MIT",
  "magpie": {
    "provider": {
      "kind": "download-client",
      "label": "Direct downloads (HTTP)",
      "basic": [
        "name",
        "downloadDir"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@magpiejs/downloads": "0.0.0",
    "@magpiejs/types": "0.0.0",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@cordisjs/plugin-http": "1.5.2",
    "@cordisjs/plugin-timer": "^1.1.3",
    "@magpiejs/database": "0.0.0",
    "@magpiejs/decision": "0.0.0",
    "@magpiejs/jobs": "0.0.0",
    "@magpiejs/library": "0.0.0",
    "cordis": "4.0.0-rc.10"
  }
}
