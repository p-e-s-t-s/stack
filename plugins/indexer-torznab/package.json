{
  "name": "@magpiejs/indexer-torznab",
  "version": "0.0.0",
  "description": "Torznab and Newznab indexers (including Prowlarr) for Magpie",
  "type": "module",
  "license": "MIT",
  "magpie": {
    "provider": {
      "kind": "indexer",
      "label": "Torznab / Newznab (Prowlarr)",
      "basic": [
        "name",
        "url",
        "apiKey"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@magpiejs/indexers": "0.0.0",
    "@magpiejs/types": "0.0.0",
    "fast-xml-parser": "^5.11.1",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@cordisjs/plugin-http": "^1.5.2",
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@cordisjs/plugin-http": "1.5.2",
    "@cordisjs/plugin-timer": "^1.1.3",
    "@magpiejs/database": "0.0.0",
    "@magpiejs/decision": "0.0.0",
    "@magpiejs/jobs": "0.0.0",
    "cordis": "4.0.0-rc.10"
  }
}
